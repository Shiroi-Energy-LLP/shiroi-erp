# Tier B re-extraction: extracted doc texts (large, generated, not needed in git)
scripts/data/tier-b-doc-texts/
scripts/data/proposal-samples/

# Growatt credentials (passwords) — input to discover-growatt-plant-ids.ts.
# The discovery output JSON/MD does NOT contain passwords and is fine to commit.
scripts/data/growatt-credentials-*.tsv

# FIMER (Aurora Vision) credentials — paired API key + portal user/pass per account.
# The fimer-plants-*.json discovery output (no secrets) IS fine to commit.
scripts/data/fimer-credentials-*.tsv

# Historical plants import (2026-06-06) — XLSX masters and derived plans
# carry plaintext portal/local/Jio passwords. Never commit.
scripts/data/se-master-file-*.xlsx
scripts/data/master-data-sheet-*.xlsx
scripts/data/shiroienergy-*.xlsx
scripts/data/credentials-brand-counts-*.md
scripts/data/master-projects-import-plan-*.md

# Plant-credentials dump (TSV input to count-plant-credentials.ts) — holds
# plaintext portal passwords. The script loads it at runtime; never commit it.
scripts/data/plant-credentials-dump.tsv
scripts/data/plant-credentials-dump-*.tsv

# Legacy one-time import data (Zoho .xls exports, etc.) — relocated out of the
# docs/ tree 2026-07-01 so it stops bloating find/Glob/agent context. Kept on
# local disk only; not tracked. Re-export from Zoho Books if ever needed again.
# The README pointer IS tracked so the location is discoverable.
/data/*
!/data/README.md

# design-sync (staged scripts, build output, machine state)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
packages/ui/dist/
