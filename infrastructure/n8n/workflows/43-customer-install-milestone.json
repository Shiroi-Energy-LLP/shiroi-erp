{
  "name": "43 — Customer: Installation milestone update",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "node-trigger",
      "name": "When called by router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "project_id",
              "value": "={{ $json.body.payload.project_id }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "customer_name",
              "value": "={{ $json.body.payload.customer_name }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "customer_phone",
              "value": "={{ $json.body.payload.customer_phone }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "milestone_name",
              "value": "={{ $json.body.payload.milestone_name }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "milestone_label",
              "value": "={{ $json.body.payload.milestone_label }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "next_step",
              "value": "={{ $json.body.payload.next_step }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-extract",
      "name": "Extract fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.META_GRAPH_API_URL }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.META_WHATSAPP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.customer_phone, type: 'template', template: {   name: 'shiroi_cust_install_milestone',   language: { code: 'en' },   components: [{     type: 'body',     parameters: [{ type: 'text', text: ($('AI Personalise').item?.json?.vars?.[0] || $('Extract fields').item.json.customer_name) }, { type: 'text', text: ($('AI Personalise').item?.json?.vars?.[1] || $('Extract fields').item.json.milestone_label) }, { type: 'text', text: ($('AI Personalise').item?.json?.vars?.[2] || $('Extract fields').item.json.next_step) }]   }] }}) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-send-wa",
      "name": "Send WhatsApp template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/customer_message_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ project_id: $('Extract fields').item.json.project_id || null, lead_id: null, recipient_phone: $('Extract fields').item.json.customer_phone, template_name: 'shiroi_cust_install_milestone', template_vars: { customer_name: $('Extract fields').item.json.customer_name, milestone_label: $('Extract fields').item.json.milestone_label, next_step: $('Extract fields').item.json.next_step }, meta_wamid: $json.messages?.[0]?.id || null, status: $json.messages?.[0]?.id ? 'sent' : 'failed', sent_at: new Date().toISOString(), failed_reason: $json.error?.message || null }) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-log",
      "name": "Log to customer_message_log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{ $env.ERP_URL + '/api/drip/personalise' }}",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.ERP_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={{ JSON.stringify({ queue_id: $json.queue_id || '', template_name: 'customer_install_milestone', customer_context: { customer_name: $json.customer_name, customer_segment: 'residential', project_number: $json.project_id, pass_through: {}, \"milestone_label\": $json.milestone_label, \"next_step\": $json.next_step }}) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-ai-personalise-customer_install_milestone",
      "name": "AI Personalise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        375,
        300
      ],
      "continueOnFail": true
    }
  ],
  "connections": {
    "When called by router": {
      "main": [
        [
          {
            "node": "Extract fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract fields": {
      "main": [
        [
          {
            "node": "AI Personalise",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp template": {
      "main": [
        [
          {
            "node": "Log to customer_message_log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Personalise": {
      "main": [
        [
          {
            "node": "Send WhatsApp template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "customer-comms"
    },
    {
      "name": "whatsapp"
    }
  ],
  "meta": {
    "event": "project.milestone_complete",
    "templateName": "shiroi_cust_install_milestone"
  }
}
