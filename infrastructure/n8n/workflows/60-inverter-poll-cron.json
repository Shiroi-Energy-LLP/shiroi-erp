{
  "name": "60 — Inverter poll cron (every 5 min, daylight only 05-19 IST)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "*/5 5-19 * * *" }
          ]
        },
        "timezone": "Asia/Kolkata"
      },
      "id": "node-cron",
      "name": "Every 5 min (05-19 IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://actqtzoxjilqnldnacqz.supabase.co/functions/v1/inverter-poll",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": { "response": { "responseFormat": "json" } },
          "timeout": 120000
        }
      },
      "id": "node-http-poll",
      "name": "POST inverter-poll Edge Function",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [250, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase service role"
        }
      }
    }
  ],
  "connections": {
    "Every 5 min (05-19 IST)": {
      "main": [
        [{ "node": "POST inverter-poll Edge Function", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "REPLACE_WITH_GLOBAL_ERROR_HANDLER_WORKFLOW_ID",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {}
}
